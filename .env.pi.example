# Replace with the workstation's LAN address. Do not use localhost on the Pi.
NONG_YOONG_SERVER_URL=http://192.168.1.100:5000

# `keyboard` waits for Enter before recording. `wake` uses the TFLite model.
NONG_YOONG_ACTIVATION=keyboard
NONG_YOONG_STT_MODEL_DIR=./models/sherpa-onnx-zipformer-thai-2024-06-20
NONG_YOONG_WAKE_MODEL=./models/keyword_model.tflite

NONG_YOONG_SAMPLE_RATE=16000
NONG_YOONG_VAD_AGGRESSIVENESS=2
NONG_YOONG_SILENCE_SECONDS=1.2
NONG_YOONG_SPEECH_START_TIMEOUT=5
NONG_YOONG_MAX_UTTERANCE=30
NONG_YOONG_RETAIN_MIC_AUDIO=false
NONG_YOONG_PLAYBACK=true
# `auto` uses FFplay under WSL and ALSA aplay on Raspberry Pi.
NONG_YOONG_AUDIO_PLAYER=auto

# Optional PortAudio/ALSA device selectors.
# NONG_YOONG_INPUT_DEVICE=USB Audio Device
# NONG_YOONG_OUTPUT_DEVICE=plughw:1,0
