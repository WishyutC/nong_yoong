[Unit]
Description=Nong Yoong Raspberry Pi voice client
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/nong_yoong
EnvironmentFile=-/home/pi/nong_yoong/.env
ExecStart=/home/pi/nong_yoong/.venv/bin/nong-yoong-client --mode wake
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
