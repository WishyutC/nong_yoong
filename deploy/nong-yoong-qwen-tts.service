[Unit]
Description=Nong Yoong isolated Qwen3-TTS speech service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=titan
WorkingDirectory=/home/titan/nong_yoong
EnvironmentFile=-/home/titan/nong_yoong/.env
ExecStart=/home/titan/nong_yoong/.venv-qwen-tts/bin/python /home/titan/nong_yoong/scripts/qwen_tts_sidecar.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
