# Workstation API
NONG_YOONG_HOST=0.0.0.0
NONG_YOONG_PORT=5000
NONG_YOONG_PUBLIC_BASE_URL=http://192.168.1.100:5000

# Existing local Ollama installation
NONG_YOONG_LLM_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:12b

# Qwen3-TTS 1.7B voice cloning service on the workstation GPU.
NONG_YOONG_TTS_BACKEND=qwen
NONG_YOONG_QWEN_TTS_URL=http://127.0.0.1:5055
NONG_YOONG_QWEN_TTS_TIMEOUT=300
NONG_YOONG_QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
NONG_YOONG_QWEN_TTS_DEVICE=cuda:0
NONG_YOONG_QWEN_TTS_DTYPE=bfloat16
NONG_YOONG_QWEN_TTS_ATTN=sdpa
NONG_YOONG_QWEN_TTS_LANGUAGE=Auto
NONG_YOONG_QWEN_TTS_MAX_NEW_TOKENS=2048
NONG_YOONG_QWEN_TTS_SPEED=0.90
NONG_YOONG_QWEN_TTS_MAX_CHUNK_CHARS=160
NONG_YOONG_QWEN_TTS_CHUNK_PAUSE_MS=180
# Use a clear 5-15 second recording and its exact transcript.
NONG_YOONG_QWEN_TTS_REF_AUDIO=/absolute/path/to/consented-thai-reference.wav
NONG_YOONG_QWEN_TTS_REF_TEXT=ข้อความตรงกับเสียงอ้างอิงทุกคำ

# Smaller non-commercial fallback.
NONG_YOONG_MMS_MODEL=facebook/mms-tts-tha
NONG_YOONG_MMS_SPEAKING_RATE=0.95
NONG_YOONG_MMS_NOISE_SCALE=0.55
NONG_YOONG_MMS_NOISE_SCALE_DURATION=0.65
NONG_YOONG_MMS_SEED=555

# Lightweight emergency fallback (robotic voice):
# NONG_YOONG_TTS_BACKEND=espeak
NONG_YOONG_ESPEAK_VOICE=th
NONG_YOONG_ESPEAK_SPEED=155

NONG_YOONG_AUDIO_DIR=./data/audio
NONG_YOONG_DATABASE_PATH=./data/conversations.sqlite3
NONG_YOONG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
