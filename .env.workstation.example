# Workstation API
NONG_YOONG_HOST=0.0.0.0
NONG_YOONG_PORT=5000
NONG_YOONG_PUBLIC_BASE_URL=http://192.168.1.100:5000

# Existing local Ollama installation
NONG_YOONG_LLM_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:12b

# Thonburian F5-TTS is the selected, more natural reference-conditioned voice.
# Its model is CC-BY-NC-SA-4.0, so replace it before commercial deployment.
NONG_YOONG_TTS_BACKEND=thonburian
NONG_YOONG_THONBURIAN_URL=http://127.0.0.1:5055
NONG_YOONG_THONBURIAN_TIMEOUT=300
NONG_YOONG_THONBURIAN_DEVICE=auto
# 32 is Thonburian's high-quality default. Use 16 if CPU latency is too high.
NONG_YOONG_THONBURIAN_NFE_STEP=32
NONG_YOONG_THONBURIAN_SPEED=1.0
NONG_YOONG_THONBURIAN_TARGET_PEAK_DBFS=-3.0
# NONG_YOONG_THONBURIAN_REF_AUDIO=/absolute/path/to/consented-reference.wav
# NONG_YOONG_THONBURIAN_REF_TEXT=ข้อความที่พูดในไฟล์เสียงอ้างอิง

# Smaller neural fallback:
# NONG_YOONG_TTS_BACKEND=mms
NONG_YOONG_MMS_MODEL=facebook/mms-tts-tha
NONG_YOONG_MMS_SPEAKING_RATE=0.95
NONG_YOONG_MMS_NOISE_SCALE=0.55
NONG_YOONG_MMS_NOISE_SCALE_DURATION=0.65
NONG_YOONG_MMS_SEED=555

# Lightweight emergency fallback (robotic voice):
# NONG_YOONG_TTS_BACKEND=espeak
NONG_YOONG_ESPEAK_VOICE=th
NONG_YOONG_ESPEAK_SPEED=155

NONG_YOONG_AUDIO_DIR=./data/audio
NONG_YOONG_DATABASE_PATH=./data/conversations.sqlite3
NONG_YOONG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
